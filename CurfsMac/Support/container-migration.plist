<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifesto di migrazione nel container della sandbox (letto da macOS al primo
  avvio sandboxato, una volta sola): fino alla 2.3.3 l'app Mac girava senza
  sandbox e salvava libreria, miniature, download e impostazioni direttamente
  nella home. Le cache (Fingerprints, locandine) non si spostano: si
  ricalcolano da sole.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/default.store</string>
		<string>${ApplicationSupport}/default.store-shm</string>
		<string>${ApplicationSupport}/default.store-wal</string>
		<string>${ApplicationSupport}/Thumbnails</string>
		<string>${ApplicationSupport}/Downloads</string>
		<string>${Documents}/Library</string>
		<string>${Library}/Preferences/com.nicoloperri.CurfsMac.plist</string>
	</array>
</dict>
</plist>
