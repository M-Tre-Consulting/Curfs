    "I profili stanno sul tuo server: inserisci prima il suo indirizzo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile liegen auf deinem Server: gib zuerst seine Adresse ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles live on your server: enter its address first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles se guardan en tu servidor: introduce primero su dirección."
          }
        },
        "fr" : {
