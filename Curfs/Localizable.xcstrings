    "Imposta l'indirizzo del tuo server con l'ingranaggio qui in alto per vedere e guardare in streaming i tuoi contenuti." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege über das Zahnrad oben die Adresse deines Servers fest, um deine Inhalte zu durchsuchen und zu streamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set your server address with the gear button above to browse and stream your content."
          }
        },
        "es" : {
          "stringUnit" : {
