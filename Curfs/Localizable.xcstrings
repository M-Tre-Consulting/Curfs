    "Imposta l'indirizzo del tuo server con l'ingranaggio qui in alto per vedere e guardare in streaming i tuoi contenuti.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege über das Zahnrad oben die Adresse deines Servers fest, um deine Inhalte zu durchsuchen und zu streamen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your server address with the gear button above to browse and stream your content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la dirección de tu servidor con el engranaje de arriba para ver y reproducir en streaming tu contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez l'adresse de votre serveur avec la roue dentée ci-dessus pour parcourir et regarder vos contenus en streaming."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'indirizzo del tuo server con l'ingranaggio qui in alto per vedere e guardare in streaming i tuoi contenuti."
          }
        }
      }
    },
