    "Gli episodi scaricati vengono cancellati dall'app; quelli sul server restano guardabili in streaming." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladene Folgen werden aus der App gelöscht; die auf dem Server bleiben per Streaming abrufbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded episodes are deleted from the app; those on the server can still be streamed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios descargados se borran de la app; los del servidor se pueden seguir viendo en streaming."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes téléchargés sont supprimés de l'app ; ceux du serveur restent disponibles en streaming."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi scaricati vengono cancellati dall'app; quelli sul server restano guardabili in streaming."
          }
        }
      }
    },
    "Guarda %@" : {
