    "Il riconoscimento di sigle e titoli di coda si basa sul difference hash (dHash) di Neal Krawetz. Le locandine appartengono ai rispettivi titolari e provengono da Wikipedia, IMDb e iTunes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung von Intro und Abspann basiert auf dem Difference Hash (dHash) von Neal Krawetz. Die Poster gehören ihren jeweiligen Rechteinhabern und stammen von Wikipedia, IMDb und iTunes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intro and end credits detection is based on Neal Krawetz's difference hash (dHash). Posters belong to their respective owners and come from Wikipedia, IMDb and iTunes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de intros y créditos finales se basa en el difference hash (dHash) de Neal Krawetz. Los pósteres pertenecen a sus respectivos titulares y proceden de Wikipedia, IMDb e iTunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des génériques de début et de fin repose sur le difference hash (dHash) de Neal Krawetz. Les affiches appartiennent à leurs détenteurs respectifs et proviennent de Wikipedia, IMDb et iTunes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento di sigle e titoli di coda si basa sul difference hash (dHash) di Neal Krawetz. Le locandine appartengono ai rispettivi titolari e provengono da Wikipedia, IMDb e iTunes."
          }
        }
      }
    },
    "Il riconoscimento di sigle e titoli di coda si basa sul difference hash (dHash) di Neal Krawetz. Le locandine appartengono ai rispettivi titolari e provengono da iTunes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung von Intro und Abspann basiert auf dem Difference Hash (dHash) von Neal Krawetz. Die Poster gehören ihren jeweiligen Rechteinhabern und stammen von iTunes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intro and end credits detection is based on Neal Krawetz's difference hash (dHash). Posters belong to their respective owners and come from iTunes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de intros y créditos finales se basa en el difference hash (dHash) de Neal Krawetz. Los pósteres pertenecen a sus respectivos titulares y proceden de iTunes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des génériques de début et de fin repose sur le difference hash (dHash) de Neal Krawetz. Les affiches appartiennent à leurs titulaires respectifs et proviennent d'iTunes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento di sigle e titoli di coda si basa sul difference hash (dHash) di Neal Krawetz. Le locandine appartengono ai rispettivi titolari e provengono da iTunes."
          }
        }
      }
    },
    "Il server ha risposto con un errore (HTTP %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit einem Fehler geantwortet (HTTP %lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server responded with an error (HTTP %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió con un error (HTTP %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu par une erreur (HTTP %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto con un errore (HTTP %lld)."
          }
        }
      }
    },
    "Il server ha risposto, ma non con un elenco di cartelle in JSON (serve nginx con «autoindex_format json»).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat geantwortet, aber nicht mit einer Ordnerliste in JSON (nginx mit „autoindex_format json“ wird benötigt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server responded, but not with a JSON folder listing (nginx with “autoindex_format json” is required)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió, pero no con una lista de carpetas en JSON (se necesita nginx con «autoindex_format json»)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu, mais pas avec une liste de dossiers en JSON (nginx avec « autoindex_format json » est nécessaire)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto, ma non con un elenco di cartelle in JSON (serve nginx con «autoindex_format json»)."
          }
        }
      }
    },
    "Il server non accetta il caricamento di copertine: va abilitato PUT/DELETE (WebDAV) su nginx per i file poster.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server akzeptiert keine Cover-Uploads: Aktiviere PUT/DELETE (WebDAV) in nginx für die Posterdateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn't accept cover uploads: enable PUT/DELETE (WebDAV) in nginx for poster files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no acepta subir portadas: activa PUT/DELETE (WebDAV) en nginx para los archivos de póster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'accepte pas l'envoi d'affiches : activez PUT/DELETE (WebDAV) dans nginx pour les fichiers poster."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non accetta il caricamento di copertine: va abilitato PUT/DELETE (WebDAV) su nginx per i file poster."
          }
        }
      }
    },
    "Importa film o intere stagioni dai tuoi file.\nRiconosco automaticamente le stagioni dai nomi delle cartelle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere Filme oder ganze Staffeln aus deinen Dateien.\nStaffeln werden automatisch an den Ordnernamen erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import movies or whole seasons from your files.\nSeasons are recognized automatically from folder names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa películas o temporadas completas desde tus archivos.\nLas temporadas se reconocen automáticamente por el nombre de las carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des films ou des saisons entières depuis vos fichiers.\nLes saisons sont reconnues automatiquement d'après le nom des dossiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa film o intere stagioni dai tuoi file.\nRiconosco automaticamente le stagioni dai nomi delle cartelle."
          }
        }
      }
