        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non accetta il salvataggio dei profili: va abilitato PUT/DELETE (WebDAV) su nginx per la cartella .curfs."
          }
        }
      }
    },
    "Importa film o intere stagioni dai tuoi file.\nRiconosco automaticamente le stagioni dai nomi delle cartelle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere Filme oder ganze Staffeln aus deinen Dateien.\nStaffeln werden automatisch an den Ordnernamen erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import movies or whole seasons from your files.\nSeasons are recognized automatically from folder names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa películas o temporadas completas desde tus archivos.\nLas temporadas se reconocen automáticamente por el nombre de las carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des films ou des saisons entières depuis vos fichiers.\nLes saisons sont reconnues automatiquement d'après le nom des dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa film o intere stagioni dai tuoi file.\nRiconosco automaticamente le stagioni dai nomi delle cartelle."
          }
        }
      }
