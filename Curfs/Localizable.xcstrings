          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server doesn't accept saving profiles: enable PUT/DELETE (WebDAV) in nginx for the .curfs folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no acepta guardar perfiles: hay que activar PUT/DELETE (WebDAV) en nginx para la carpeta .curfs."
